# Copy this file to .env for local development, or pass these as environment
# variables / a compose "environment:" block when running the container.

# A long random string used to sign session cookies. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# Account 1 (Lu)
LU_USERNAME="lu"
# Generate with: npm run hash-password -- "yourPasswordHere"
LU_PASSWORD_HASH="replace-with-a-bcrypt-hash"

# Account 2 (Wife) - display name is optional, defaults to "Wife"
WIFE_USERNAME="wife"
WIFE_PASSWORD_HASH="replace-with-a-bcrypt-hash"
WIFE_DISPLAY_NAME="Wife"

# Only used outside Docker (local `npm run dev`) - inside the container this is
# fixed to /app/data/budget.db and the volume handles persistence instead.
DATABASE_PATH="./data/budget.db"
